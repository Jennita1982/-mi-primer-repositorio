# Programa para calcular el promedio de 3 notas con validación

def leer_nota(numero):
    """Lee una nota válida entre 1.0 y 7.0"""
    while True:
        try:
            nota = float(input(f"Ingrese la nota {numero} (1.0 a 7.0): "))
            if 1.0 <= nota <= 7.0:
                return nota
            else:
                print("❌ Error: La nota debe estar entre 1.0 y 7.0.")
        except ValueError:
            print("❌ Error: Ingrese un número válido.")

def calcular_promedio(notas):
    """Calcula el promedio de una lista de notas"""
    return sum(notas) / len(notas)

def main():
    print("=== Cálculo de Promedio de 3 Notas ===")
    notas = [leer_nota(i) for i in range(1, 4)]
    promedio = calcular_promedio(notas)
    print(f"\n📊 El promedio de las 3 notas es: {promedio:.2f}")

if __name__ == "__main__":
    main()